# Deployment variables for the SwiftProof Swarm stack.
# Copy this file to `.env` (gitignored) and adjust as needed.

# Public hostname the promotional website is served on.
SWIFTPROOF_WEB_DOMAIN=swiftproof.net

# Public hostname the web application (the hub) is served on.
SWIFTPROOF_APP_DOMAIN=app.swiftproof.net

# --- Web application -------------------------------------------------------
# The stack deploys the hub without credentials, so the domain answers as soon
# as DNS points at the edge; the sign-in page then states that no forge is
# configured. Sign-in starts working once an OAuth application is registered
# and its two variables are set here. Set this to false to make a missing
# forge a startup error instead.
SWIFTPROOF_HUB_ALLOW_NO_FORGE=true

# Register the OAuth application on the forge with:
#   callback  https://app.swiftproof.net/auth/github/callback   (scopes repo,read:org)
#   callback  https://app.swiftproof.net/auth/gitlab/callback   (scope api)
# SWIFTPROOF_HUB_GITHUB_CLIENT_ID=
# SWIFTPROOF_HUB_GITHUB_CLIENT_SECRET=
# SWIFTPROOF_HUB_GITLAB_CLIENT_ID=
# SWIFTPROOF_HUB_GITLAB_CLIENT_SECRET=

# GitHub Enterprise or a self-managed GitLab only needs its hosts here.
# SWIFTPROOF_HUB_GITHUB_URL=https://github.com
# SWIFTPROOF_HUB_GITHUB_API_URL=https://api.github.com
# SWIFTPROOF_HUB_GITLAB_URL=https://gitlab.com

# lint (default) never executes repository code; review needs a Docker socket,
# which this stack does not mount.
# SWIFTPROOF_HUB_MODE=lint
# SWIFTPROOF_HUB_WORKERS=2
# SWIFTPROOF_HUB_DEFAULT_BRANCH_ONLY=false

# 64 hex characters. Generated and persisted in the data volume when unset;
# set it to keep sessions valid across a volume rebuild.
# SWIFTPROOF_HUB_SESSION_KEY=
